# DISCORD BOT CONFIGURATION
DISCORD_BOT_TOKEN=your_discord_bot_token_here
ALLOWED_GUILD_ID=your_discord_server_guild_id_here
ADMIN_USER_ID=your_discord_user_id_here

# (Optional) Dedicated Discord Channel ID for Staff Payment Verification Alerts
# If omitted or 0, payment verification alerts are sent directly to ADMIN_USER_ID via DM
PAYMENT_LOG_CHANNEL_ID=0

# (Optional) Web Redirect Base URL for One-Click Button (e.g. http://localhost:5000 or https://yourdomain.com)
# If omitted, an interactive mobile deep-link menu is displayed directly inside Discord
REDIRECT_BASE_URL=

# SMTP EMAIL CONFIGURATION (Invoicing & Payment Receipts)
SMTP_HOST=host3.xhost.co.in
SMTP_PORT=465
SMTP_USER=your_smtp_user@example.com
SMTP_PASSWORD=your_actual_smtp_password_here
SMTP_FROM=your_smtp_user@example.com
SMTP_FROM_NAME=Glacier.QR Payments
